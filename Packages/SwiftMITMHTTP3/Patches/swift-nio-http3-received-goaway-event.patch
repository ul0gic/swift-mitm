+import HTTP3
+
+@available(anyAppleOS 27, *)
+public struct ReceivedGoawayEvent: Sendable, Hashable {
+    public let id: HTTP3GoawayID
+
+    public init(id: HTTP3GoawayID) {
+        self.id = id
+    }
