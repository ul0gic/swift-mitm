--swiftversion 6.4
--exclude .build,Vendor

--disable andOperator,blankLinesBetweenImports,blankLinesBetweenScopes,conditionalAssignment,hoistTry,numberFormatting,opaqueGenericParameters,redundantReturn,redundantSelf,redundantSendable,redundantVariable,sortImports,spaceAroundOperators,trailingCommas,unusedArguments,wrapFunctionBodies,wrapLoopBodies,wrapMultilineStatementBraces,wrapPropertyBodies

--max-width 120
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--allow-partial-wrapping false
--enable wrapMultilineFunctionChains
--modifier-order override,isolated,nonisolated,acl,setteracl,dynamic,mutators,lazy,final,required,convenience,static,class,owned
--guard-else same-line
